{
  "name": "cimmich-local-service",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "overrides": {
    "brace-expansion": "^5.0.9"
  },
  "scripts": {
    "archive-mobility-conformance": "node acceptance/archive-mobility-journey.mjs",
    "archive-match": "node bin/run-source-pack-archive-matcher.mjs",
    "bind-verified-content": "node bin/bind-verified-content.mjs",
    "asset-similarity-conformance": "node acceptance/asset-similarity-provider-journey.mjs",
    "bootstrap-public-demo": "node bin/bootstrap-public-demo.mjs",
    "bootstrap-public-demo-immich": "node bin/bootstrap-public-demo-immich.mjs",
    "body-provider-conformance": "node bin/validate-body-provider-conformance.mjs",
    "body-detector-review": "node bin/validate-body-detector.mjs",
    "commit-recognition-job": "node bin/commit-recognition-job.mjs",
    "document-lifecycle": "node bin/document-lifecycle.mjs",
    "docker-image-retention": "node ../tools/cimmich_image_retention.mjs",
    "guided-local-conformance": "node bin/guided-local-conformance.mjs",
    "import-xmp-sidecars": "node bin/import-xmp-sidecars.mjs",
    "repair-inventory-asset-splits": "node bin/repair-inventory-asset-splits.mjs",
    "repair-inventory-only-jobs": "node bin/repair-inventory-only-jobs.mjs",
    "link-face-bodies": "node bin/link-face-bodies.mjs",
    "media-job": "node bin/media-job.mjs",
    "matching-qc-cohort": "node bin/evaluate-matching-qc-cohort.mjs",
    "matching-lever-review": "node bin/evaluate-matching-lever.mjs",
    "migrate": "node bin/migrate.mjs",
    "provider-review": "node bin/evaluate-provider-review.mjs",
    "prune-inventory-placeholders": "node bin/prune-inventory-placeholder-jobs.mjs",
    "reconcile-immich-archive": "node bin/reconcile-immich-archive.mjs",
    "rollover-immich-source": "node bin/rollover-immich-inventory-source.mjs",
    "detect-face-backlog": "node bin/run-face-detection-backlog.mjs",
    "detect-body-backlog": "node bin/run-body-detection-backlog.mjs",
    "pose-body-backlog": "node bin/run-body-pose-backlog.mjs",
    "recognize-existing-face-backlog": "node bin/run-existing-face-recognition-backlog.mjs",
    "sync-immich-inventory": "node bin/sync-immich-inventory.mjs",
    "reference-accumulation": "node bin/build-reference-accumulation-galleries.mjs",
    "rebuild-source-pack": "node bin/run-source-pack-rebuild-worker.mjs",
    "secondary-routing-gate": "node bin/secondary-routing-gate.mjs",
    "source-pack-lifecycle": "node bin/source-pack-lifecycle.mjs",
    "start": "node bin/start.mjs",
    "storage-budget-preflight": "node ../tools/storage_budget_preflight.mjs",
    "format": "prettier --check \"{acceptance,bin,src,test}/**/*.mjs\" \"package*.json\"",
    "format:fix": "prettier --write \"{acceptance,bin,src,test}/**/*.mjs\" \"package*.json\"",
    "lint": "eslint \"{acceptance,bin,src,test}/**/*.mjs\"",
    "check:syntax": "../tools/run_service_syntax_check.sh",
    "validate-recognition-provider": "node bin/validate-recognition-provider.mjs",
    "visibility-credential": "node bin/visibility-credential.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "globals": "^17.0.0",
    "prettier": "^3.8.3"
  }
}
