# Copy this file to .env, fill the three required values, then run:
#   docker compose config --quiet
#   docker compose up --detach --build --wait
#
# Generate the database password locally with: openssl rand -hex 32
CIMMICH_DB_PASSWORD=

# Credential-free URLs reachable from inside Docker. For Immich on the same
# computer at its default port, these defaults are normally correct.
CIMMICH_IMMICH_API_URL=http://host.docker.internal:2283/api
CIMMICH_IMMICH_WEB_ORIGIN=http://host.docker.internal:2283

# Optional project and loopback UI settings.
CIMMICH_COMPANION_PROJECT=cimmich-companion
CIMMICH_COMPANION_UI_BIND_ADDRESS=127.0.0.1
CIMMICH_COMPANION_UI_PORT=3413
CIMMICH_COMPANION_API_PORT=3411
# Add the exact trusted-interface origin when binding beyond loopback.
# CIMMICH_ALLOWED_ORIGINS=http://127.0.0.1:3413,http://localhost:3413,http://TRUSTED_INTERFACE_IP:3413

# Optional prebuilt-image overrides. The ordinary public path builds the exact
# checked-in Dockerfiles locally. Set both only when you deliberately trust and
# can pull an external registry, preferably using immutable digests.
# CIMMICH_API_IMAGE=registry.example/cimmich-api@sha256:...
# CIMMICH_UI_IMAGE=registry.example/cimmich-ui@sha256:...

# Optional database backup location. Use compose.database-backup.yaml only
# after creating this folder on a physically independent disk or mounted
# network destination. A folder on the Cimmich database disk is not a backup.
# CIMMICH_DATABASE_BACKUP_PATH=/mounted/independent-disk/cimmich-database
# CIMMICH_DATABASE_BACKUP_LABEL=Primary database backup
# CIMMICH_DATABASE_BACKUP_DESCRIPTION=External drive or NAS
# CIMMICH_DATABASE_BACKUP_STORAGE_DOMAIN=independent-disk-id

# Cimmich connects to Immich only after the signed-in owner enters a dedicated
# read-only API key in Cimmich's write-only Settings field. Never put that key,
# an Immich password or another secret in this file.
